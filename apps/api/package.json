{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/api",
    "build": "go build -o bin/api ./cmd/api",
    "lint": "go vet ./...",
    "lint:fix": "command -v go >/dev/null 2>&1 && (gofmt -w . && go vet ./...) || (echo 'api: skipping lint:fix (go not installed)' && exit 0)",
    "format": "gofmt -w .",
    "format:check": "test -z \"$(gofmt -l .)\"",
    "check": "go build ./... && go vet ./...",
    "check-types": "go build ./...",
    "test": "go test ./...",
    "test:rfq": "go test -v -count=1 -run \"Test(RFQExtractor|RFQExtractionSchema|RFQService_CreateTextDraft|RFQService_CreateWhatsAppMockDraft|CatalogMatchService|QuoteService_AcceptMaterials|RFQHandler_CreateTextDraft|ToTextRFQDraftResponse)\" ./internal/ai ./internal/services ./internal/delivery/http/handler",
    "test:rfq:integration": "go test -v -count=1 -tags=integration -run \"Test(CatalogMatch|RFQPipeline|RFQTextDraftRoute|WhatsAppMockRoute|UnmatchedItems|QuotePricing)\" ./internal/integration",
    "test:rfq:response": "go test -v -count=1 -run \"^TestRFQHandler_CreateTextDraft_ReturnsAReviewableDraft$\" ./internal/delivery/http/handler",
    "docs": "go tool swag init --generalInfo main.go --dir cmd/api,internal/delivery/http --output docs --parseInternal",
    "docs:check": "pnpm run docs && test -z \"$(git status --porcelain -- docs)\""
  }
}
