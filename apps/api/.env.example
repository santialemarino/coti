# Coti API — environment variables.
# Defaults live in apps/api/internal/config; values here override them at startup.

DATABASE_URL=postgres://coti_app:coti_app@localhost:5432/coti?sslmode=disable   # restricted, RLS-subject
DATABASE_ADMIN_URL=postgres://coti:coti@localhost:5432/coti?sslmode=disable  # owner; migrations, cron, pre-auth
AUTH_JWT_SECRET=your-jwt-secret-here   # HMAC secret; must match the frontend auth secret
API_PORT=8000
