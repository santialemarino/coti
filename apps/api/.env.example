# Coti API — environment variables.
# Every key below is optional except the three marked required; defaults live in
# apps/api/internal/config.

# --- Runtime ---------------------------------------------------------------
ENV=development                          # development | production
LOG_LEVEL=info                           # debug | info | warn | error
API_PORT=8000

# --- Database (both required) ---------------------------------------------
# Restricted, RLS-subject role: every request-scoped query runs here.
DATABASE_URL=postgres://coti_app:coti_app@localhost:5432/coti?sslmode=disable
# Owner role: goose migrations, the follow-up cron, and the pre-auth lookups that
# cannot know the account yet (login by email, resolving a public quote token).
# Bypasses RLS — never use it for a request-scoped query.
DATABASE_ADMIN_URL=postgres://coti:coti@localhost:5432/coti?sslmode=disable

# Pool sizing, applied to both pools.
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=30
DB_CONNECT_TIMEOUT_SECONDS=10

# --- Auth ------------------------------------------------------------------
# Required. HMAC secret for API-issued JWTs; minimum 32 characters. It stays in the
# API: the key is symmetric, so anything holding it can mint a token for any account.
# The frontends forward the token and never inspect it.
AUTH_JWT_SECRET=your-jwt-secret-at-least-32-characters

AUTH_ACCESS_TTL_MINUTES=15               # short-lived access token
AUTH_REFRESH_TTL_HOURS=12                # refresh token, normal session
AUTH_REFRESH_REMEMBER_DAYS=30            # refresh token, "remember me"
AUTH_REFRESH_REUSE_GRACE_SECONDS=30      # replaying a consumed token inside this
                                         # window is a benign race; beyond it the
                                         # whole token family is revoked as theft
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12              # length floor every password path applies, on top of the
                                         # fixed rule that one must carry an uppercase letter, a
                                         # lowercase letter, a number and a symbol; 8 is the
                                         # minimum the config accepts
AUTH_PASSWORD_RESET_TTL_MINUTES=60       # how long a recovery link stays redeemable
AUTH_EMAIL_VERIFICATION_TTL_HOURS=48     # how long a confirmation link stays redeemable
AUTH_REQUIRE_VERIFIED_EMAIL=false        # a confirmed address is needed to log in. Starts off
                                         # and the config refuses to turn it on while
                                         # MAIL_PROVIDER is console, which delivers nothing

# --- Outbound mail ----------------------------------------------------------
MAIL_PROVIDER=console                    # console | smtp. console writes the message to the
                                         # log instead of sending it; for a real message in
                                         # development, use smtp against the mailpit sandbox
                                         # in docker-compose and read it at localhost:8025
MAIL_FROM_ADDRESS=                       # sender; required unless MAIL_PROVIDER is console
MAIL_FROM_NAME=Coti

# Read only when MAIL_PROVIDER is smtp. The four credential keys below are then all required,
# even against a sandbox that asks for none. They are the installation's credentials, one
# account per environment — not one corralón's.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true                  # required, not negotiated: a server that stops
                                         # advertising STARTTLS fails the send instead of
                                         # downgrading it. false only for a local sandbox
                                         # (mailpit on 1025), which speaks no TLS
MAIL_SMTP_TIMEOUT_SECONDS=10             # caps the dial and the whole SMTP conversation

# --- AI providers -----------------------------------------------------------
# Three capabilities, selected one by one: no provider covers all of them, and an environment
# may want the language model without the transcriber. Each arrives disabled, so a fresh
# checkout boots with no keys — the engine then refuses the calls that needed a model instead
# of the process refusing to start. Turning one on makes its key required at startup.

AI_LLM_PROVIDER=disabled                 # disabled | anthropic. Extraction, catalog matching
                                         # and the change handler, all with a forced schema
AI_LLM_MODEL=claude-opus-5
AI_LLM_EFFORT=low                        # low | medium | high | xhigh | max. How much the model
                                         # reasons before answering. Extraction and
                                         # classification are mapping work, so the default sits
                                         # at the low end; this is the knob that replaced
                                         # temperature, which the model no longer accepts
AI_LLM_MAX_TOKENS=16000                  # caps one answer, the model's own reasoning included
AI_LLM_TIMEOUT_SECONDS=60                # caps one attempt, not the whole retry chain
AI_ANTHROPIC_API_KEY=                    # required when AI_LLM_PROVIDER is anthropic
AI_ANTHROPIC_BASE_URL=                   # empty in normal use: the SDK carries the provider's
                                         # own address. Set it to reach a gateway

AI_EMBEDDINGS_PROVIDER=disabled          # disabled | openai. Vectorizes the catalog and each
                                         # RFQ line for semantic search
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AI_EMBEDDINGS_TIMEOUT_SECONDS=30

AI_TRANSCRIPTION_PROVIDER=disabled       # disabled | openai. Turns voice notes into text
AI_TRANSCRIPTION_MODEL=whisper-1
AI_TRANSCRIPTION_TIMEOUT_SECONDS=120     # a long recording takes a while to come back

AI_OPENAI_API_KEY=                       # required when either AI_EMBEDDINGS_PROVIDER or
                                         # AI_TRANSCRIPTION_PROVIDER is openai
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# Applied to every provider call. The wait doubles from the backoff, so a provider that is rate
# limiting gets progressively more room. Rate limits, provider-side faults, dropped connections
# and answers that miss the schema are retried; a rejected request is not.
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1

# --- Frontend URLs -----------------------------------------------------------
WEB_BACKOFFICE_URL=http://localhost:3000  # base of the links the API mails; the recovery link
                                          # lands on a backoffice screen, not an API route

# --- Rate limits -----------------------------------------------------------
# The key is the authenticated user when a request carries a readable token, and the
# client address when it does not, so one caller cannot spend another's allowance.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=300                 # allowance for all of /v1
RATE_LIMIT_CREDENTIALS_MAX=10             # login, reset-password, verify-email
RATE_LIMIT_SIGNUP_MAX=5                   # public account registration
RATE_LIMIT_MAIL_MAX=5                     # the routes whose effect is sending a message
# Keyed on the target address instead of the caller, so it bounds what one mailbox receives
# however many callers ask for it. Both counters have to pass for a message to go out, and
# going over this one still answers 202 — a refusal would reveal that the address exists.
RATE_LIMIT_MAIL_PER_ADDRESS_MAX=3
# Who sits in front of the API, and how many of them. The client address is counted back from
# the end proxies append to, and the header is only read from a peer inside the declared
# networks — hop counting means nothing if the peer could have written the whole header.
# The two go together: setting one without the other is a startup error.
#
# The backoffice is one such proxy: every call it makes is server-side, so without a hop here
# the API sees one address for every user in the product and they share one allowance.
# Single addresses are accepted and widened to a /32 or /128.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# --- Branches --------------------------------------------------------------
BRANCH_DEFAULT_EXPIRY_DAYS=7               # days a quote stays valid, seeded onto each new
                                           # branch; a branch can then set its own

# --- Catalog ---------------------------------------------------------------
CATALOG_DEFAULT_PAGE_SIZE=50              # page size when the request omits limit
CATALOG_MAX_PAGE_SIZE=200                 # cap on limit, so no client asks for the
                                          # whole catalog in one response
CATALOG_IMPORT_MAX_BYTES=5242880          # 5 MiB

# --- Price imports ---------------------------------------------------------
PRICE_IMPORT_MAX_BYTES=5242880            # 5 MiB

# --- HTTP server -----------------------------------------------------------
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_SHUTDOWN_TIMEOUT_SECONDS=10
