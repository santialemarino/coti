# API base URL the browser uses for logos and other public assets.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API base URL the Next server uses. In the local compose network this is http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# Trusted proxies in front of Next; zero ignores caller-supplied forwarding headers.
WEB_TRUSTED_PROXY_HOPS=0

# Shared origin every /c/<label> portal lives under. Must match the API's CUSTOMER_PORTAL_BASE_URL;
# the supplier is this hostname prefixed by the label. Defaults to http://localhost:3001.
WEB_PORTAL_BASE_URL=http://localhost:3001

# Public landing that the portal root and every path outside /c/<label> redirect to (307).
# Defaults to http://localhost:3000.
WEB_LANDING_URL=http://localhost:3000

WEB_GOOGLE_FLOW_TTL_SECONDS=600
