# API base URL the browser uses for logos and other public assets.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API base URL the Next server uses. In the local compose network this is http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# Trusted proxies in front of Next; zero ignores caller-supplied forwarding headers.
WEB_TRUSTED_PROXY_HOPS=0

# Optional hostname override for local public RFQ site development.
WEB_PUBLIC_SITE_HOSTNAME=

WEB_GOOGLE_FLOW_TTL_SECONDS=600
