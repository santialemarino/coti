# API base URL. Every call to the API is made server-side, but the NEXT_PUBLIC_ prefix inlines it
# into the bundle, so the Dockerfile takes it as a build ARG.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API URL. Docker Compose overrides this with http://api:8000 so the
# container reaches the API over its internal network; local development can keep localhost.
API_INTERNAL_URL=http://localhost:8000

# Multipart uploads include the file plus the action payload; API upload limits still apply.
SERVER_ACTION_BODY_SIZE_LIMIT=16mb

# Rows revealed at a time in the catalog and price import previews.
NEXT_PUBLIC_CATALOG_PREVIEW_PAGE_SIZE=25

# --- Session ---------------------------------------------------------------
# How long before an access token expires the session is renewed, so a request
# cannot start with a token that expires mid-flight.
AUTH_REFRESH_SKEW_SECONDS=60

# How long a "mantener la sesión abierta" session's cookies survive. Mirrors the API's
# AUTH_REFRESH_REMEMBER_DAYS; the API still decides whether the token is live.
AUTH_REMEMBERED_SESSION_DAYS=30

# How long the "enviar un enlace nuevo" button stays shut after a send. Read in the browser, so it
# must be NEXT_PUBLIC_. Keep it tuned with the API's RATE_LIMIT_MAIL_PER_ADDRESS_MAX (3 per 60s,
# which answers 202 either way) so at least two sends fit in a window. Default 30.
NEXT_PUBLIC_AUTH_RESEND_COOLDOWN_SECONDS=30

# How many intermediaries sit in front of THIS app, used to work out the browser's address so
# the API can rate-limit per user rather than per Next server. 0 locally, where nothing is in
# front; 1 behind a single load balancer or CDN.
WEB_TRUSTED_PROXY_HOPS=0

# --- Invoicing -------------------------------------------------------------
# How many days before the ARCA certificate expires the invoicing screens warn that it has to be
# renewed. Default 30.
ARCA_CERTIFICATE_RENEWAL_DAYS=30

# Debounce for advisory customer portal availability checks.
NEXT_PUBLIC_PORTAL_AVAILABILITY_DELAY_SECONDS=1
