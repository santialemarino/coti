{
  "name": "coti",
  "version": "1.0.0",
  "description": "Coti — AI-assisted quoting platform for building materials suppliers",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:docker": "docker compose up -d",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "pnpm format:web && pnpm format:api",
    "format:check": "pnpm format:check:web && pnpm format:check:api",
    "format:web": "prettier --write .",
    "format:check:web": "prettier --check .",
    "format:api": "pnpm --filter api run format",
    "format:check:api": "pnpm --filter api run format:check",
    "check": "pnpm check:api && pnpm check:web",
    "check:api": "pnpm --filter api run check",
    "check:web": "turbo run check-types --filter=backoffice --filter=webapp",
    "check-types": "turbo run check-types",
    "test": "pnpm test:scripts && pnpm test:api && pnpm test:web",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "docs:api": "pnpm --filter api run docs",
    "docs:api:check": "pnpm --filter api run docs:check",
    "test:api": "pnpm --filter api run test",
    "test:rfq": "pnpm --filter api run test:rfq",
    "test:rfq:integration": "pnpm --filter api run test:rfq:integration",
    "test:rfq:response": "pnpm --filter api run test:rfq:response",
    "eval:rfq": "node scripts/rfq-eval.mjs",
    "debug:rfq": "node scripts/rfq-eval.mjs --trace --api-url http://127.0.0.1:8001 --wait-seconds 10",
    "debug:rfq:case": "node scripts/rfq-eval.mjs --trace --case explicit-quantity --api-url http://127.0.0.1:8001 --wait-seconds 10",
    "report:rfq": "node scripts/rfq-report.mjs",
    "serve:rfq": "node scripts/rfq-serve.mjs",
    "test:web": "turbo run test --filter=backoffice --filter=webapp --filter=@repo/ui",
    "clean": "pnpm --recursive exec rm -rf node_modules .next dist",
    "install:all": "pnpm install",
    "dev:backoffice": "pnpm --filter backoffice run dev",
    "dev:webapp": "pnpm --filter webapp run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:ui": "pnpm --filter @repo/ui run dev",
    "build:backoffice": "pnpm --filter backoffice run build",
    "build:webapp": "pnpm --filter webapp run build",
    "build:api": "pnpm --filter api run build",
    "build:ui": "pnpm --filter @repo/ui run build",
    "db:init": "node scripts/db-init.mjs",
    "db:migrate": "node scripts/goose.mjs up",
    "db:migrate:down": "node scripts/goose.mjs down",
    "db:migrate:status": "node scripts/goose.mjs status",
    "db:create-migration": "node scripts/goose.mjs create",
    "db:seed": "node scripts/db-seed.mjs",
    "db:vector-index": "node scripts/db-vector-index.mjs",
    "db:account:deactivate": "node scripts/db-account.mjs deactivate",
    "db:account:activate": "node scripts/db-account.mjs activate",
    "db:reset": "docker compose down -v && pnpm db:init",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/backoffice/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter backoffice run lint:fix",
      "prettier --write"
    ],
    "apps/webapp/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter webapp run lint:fix",
      "prettier --write"
    ],
    "packages/ui/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @repo/ui run lint:fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,scss,html,yml,yaml,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "pg": "^8.22.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.13",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  }
}
