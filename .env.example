# Coti — root environment reference (used by docker-compose and shared tooling).
# Copy to .env and fill real values. Never commit .env. No secrets belong in this file.

# PostgreSQL (docker-compose). Also the building blocks for DATABASE_URL.
POSTGRES_USER=coti
POSTGRES_PASSWORD=coti
POSTGRES_DB=coti
# Host port Postgres publishes on (container side is always 5432). Change it when
# another local Postgres already holds the port; keep it in sync with DATABASE_URL.
POSTGRES_PORT=5432

# Restricted, RLS-subject role the API uses for request-scoped queries. The migration chain
# creates it with no password; pnpm db:init sets this one, a deployment sets its own.
DATABASE_URL=postgres://coti_app:coti_app@localhost:5432/coti?sslmode=disable
# Owner role: goose migrations, the follow-up cron, and pre-auth lookups that
# legitimately span accounts (login by email, resolving a public quote token).
# Bypasses RLS — never use it for a request-scoped query.
DATABASE_ADMIN_URL=postgres://coti:coti@localhost:5432/coti?sslmode=disable

# HMAC secret the API signs its JWTs with. Minimum 32 chars. Read by the API only —
# it is symmetric, so a second holder could mint tokens for any account.
AUTH_JWT_SECRET=

# HMAC secret the API signs storage links with. Minimum 32 chars. A link is only as
# private as this value, so a deployment that shares it shares every stored file.
STORAGE_LOCAL_SIGNING_SECRET=

# Public API base URL exposed to the Next.js apps at build and runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000
