# Coti — root environment reference (used by docker-compose and shared tooling).
# Copy to .env and fill real values. Never commit .env. No secrets belong in this file.

# PostgreSQL (docker-compose). Also the building blocks for DATABASE_URL.
POSTGRES_USER=coti
POSTGRES_PASSWORD=coti
POSTGRES_DB=coti
# Host port Postgres publishes on (container side is always 5432). Change it when
# another local Postgres already holds the port; keep it in sync with DATABASE_URL.
POSTGRES_PORT=5432

# Database connection string consumed by the API and migration tooling (goose).
DATABASE_URL=postgres://coti:coti@localhost:5432/coti?sslmode=disable

# Shared auth secret — HMAC secret for API-issued JWTs. Minimum 32 chars.
# Must stay in sync across services.
AUTH_JWT_SECRET=

# Public API base URL exposed to the Next.js apps at build and runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000
